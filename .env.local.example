# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (from 'supabase start' output)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Payments (Milestone 9). No gateway is connected yet: online and split payments use a
# sandbox provider that records the payment as paid without moving money. It is on in
# development and OFF in production unless you set this to 1 (for demos only).
# PAYMENTS_TEST_MODE=1

# Stripe / ClickToPay (a real provider replaces the sandbox)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio (for Milestone 10 - SMS/WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Email (Milestone 10): booking confirmations, split-payment invitations, cancellation
# notices, two-hour reminders, staff invites and verification decisions are sent over SMTP
# with Nodemailer. The provider is Brevo (smtp-relay.brevo.com, port 587, STARTTLS): in Brevo open
# SMTP & API > SMTP, copy the login and create an SMTP key. Without SMTP_USER (and without SMTP_HOST)
# emails are recorded in the `notifications` table as "skipped" and nothing is sent (fine for development).
# A failed send never breaks a booking: it is logged, reported to Sentry and retried by the cron run.
# SMTP_USER=                 Brevo SMTP login (setting it turns sending on)
# SMTP_PASS=                 Brevo SMTP key (not your account password)
# SMTP_HOST=smtp-relay.brevo.com   optional: this is the default once SMTP_USER is set
# SMTP_PORT=587              587 = STARTTLS (default), 465 = implicit TLS
# The sender must be verified in Brevo (Senders & domains: authenticate the domain with SPF/DKIM/DMARC),
# or mail is rejected or lands in spam. EMAIL_FROM is the older name and still works.
# SMTP_FROM="ShiftGrid <noreply@your-verified-domain>"
# ADMIN_EMAIL=               receives "new club pending verification" notices
# EMAIL_DRY_RUN=1            render and record but never send, even with credentials
# Protects /api/cron/notifications (reminders + retries). 16+ random characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
# Without it the endpoint answers 503 (off).
# CRON_SECRET=

# PostHog analytics. Tracking is disabled unless BOTH are set. Public project key (phc_...);
# EU projects use https://eu.i.posthog.com. Anonymous visitors get no person profile, autocapture
# is off, one $pageview per route change. Do NOT set in production before a consent gate exists.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Optional. `development` marks every event from this build as is_internal_user (PostHog internal-user filter).
# localhost is always internal; on production a team member runs shiftgridInternal.enable() in the DevTools console.
NEXT_PUBLIC_APP_ENV=
# Server-side PostHog events (rate_limit_exceeded, api_request_perf, audit_log_event) use the two POSTHOG vars above.
# Set TELEMETRY_DISABLED=1 to stop them without touching the browser analytics.
TELEMETRY_DISABLED=

# App Configuration
# The public site, used for EVERY link in an email (booking pass, cancel link, staff invitation) and as the
# Supabase Site URL. If unset the code falls back to https://shiftgridtn.vercel.app (lib/app-url.ts).
# Set http://localhost:3000 only if you want emails sent from `next dev` to link to your own machine.
# It is inlined at build time: after changing it on Vercel, REDEPLOY.
NEXT_PUBLIC_APP_URL=https://shiftgridtn.vercel.app
#
# ---- Supabase Auth redirect URLs (Authentication > URL Configuration) ---------------------------------
# Supabase sends people back ONLY to URLs on its allow-list; anything else falls back to the Site URL, so a
# password-reset / confirmation / invitation email lands on the wrong site. The project needs:
#
#   Site URL           = NEXT_PUBLIC_APP_URL                       e.g. https://shiftgridtn.vercel.app
#   Redirect URLs      ${NEXT_PUBLIC_APP_URL}/auth/callback        invitations, sign-up confirmation, magic links
#                      ${NEXT_PUBLIC_APP_URL}/accept-invitation    where a Supabase invitation lands (name + password)
#                      ${NEXT_PUBLIC_APP_URL}/reset-password       password recovery (the /forgot-password link)
#                      http://localhost:3000/auth/callback         local development
#                      http://localhost:3000/accept-invitation
#                      http://localhost:3000/reset-password
#
# They live in supabase/config.toml (auth.site_url, auth.additional_redirect_urls). Push and verify:
#   1. supabase config diff        MUST list only auth.site_url and auth.additional_redirect_urls as "update"
#                                  (it reads the linked hosted project; it changes nothing)
#   2. supabase config push        answer y to those two changes only (see the warning in config.toml)
#   3. npm run verify:auth-urls    probes the hosted project and prints PASS/FAIL for every URL above
# Without the CLI: paste the six URLs into the dashboard page named above, then run step 3.
# Our own emailed staff invitation (/accept-invite?token=...) never goes through Supabase: no entry needed.
# These emails are SENT by Supabase, not by SMTP_* below: set custom SMTP in the dashboard for production.
#
# Optional email templates (Authentication > Emails), so links also work when opened on another device:
#   Invite user:      {{ .SiteURL }}/auth/callback?token_hash={{ .TokenHash }}&type=invite
#   Confirm sign up:  {{ .SiteURL }}/auth/callback?token_hash={{ .TokenHash }}&type=signup
#   Magic link:       {{ .SiteURL }}/auth/callback?token_hash={{ .TokenHash }}&type=magiclink
#   Reset password:   {{ .SiteURL }}/reset-password?token_hash={{ .TokenHash }}&type=recovery

# Rate limiting (Upstash Redis). Without these the limiter runs in memory, per instance:
# fine for dev, not for production behind several instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Tests only (ignored in production): turn the limiter off.
# RATE_LIMIT_DISABLED=1

# Observability (Sentry). Nothing is sent, and the SDK stays off, without a DSN.
# One DSN serves browser and server (public by design; also added to the CSP).
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN; falls back to NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Traces: 10 % by default. Replays: none for normal sessions, 100 % of sessions that hit an error (all text masked).
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=              # defaults to VERCEL_ENV / NODE_ENV
# Release id: defaults to VERCEL_GIT_COMMIT_SHA, else `git rev-parse HEAD`. Injected into every bundle.
# SENTRY_RELEASE=
# Source map upload at build time (CI / Vercel only, never in a committed file):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Database access. The app talks to Supabase only through supabase-js over HTTPS
# (PostgREST, already pooled by Supabase), so it needs NO Postgres connection string.
# If you ever add a Postgres driver (pg, Drizzle, Prisma) in server code, use the
# Transaction pooler (port 6543, ?pgbouncer=true, prepared statements off) for the app and
# the direct/session connection (port 5432) only for migrations and admin scripts:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Legal identity (printed on /terms and /privacy; required for launch, see scripts/verify-launch-readiness.mjs) ---
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ENTITY_DETAILS=
NEXT_PUBLIC_LEGAL_EMAIL=privacy@shiftgrid.tn
