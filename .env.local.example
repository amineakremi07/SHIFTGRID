# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (from 'supabase start' output)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Payments (Milestone 9). No gateway is connected yet: online and split payments use a
# sandbox provider that records the payment as paid without moving money. It is on in
# development and OFF in production unless you set this to 1 (for demos only).
# PAYMENTS_TEST_MODE=1

# Stripe / ClickToPay (a real provider replaces the sandbox)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio (for Milestone 10 - SMS/WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Email (Milestone 10): booking confirmations, split-payment invitations, cancellation
# notices and two-hour reminders go through Resend. Without a key emails are recorded in
# the `notifications` table as "skipped" and nothing is sent (fine for development).
# RESEND_API_KEY=
# The sending domain must be verified in Resend, or every send is rejected.
# EMAIL_FROM="ShiftGrid <noreply@your-verified-domain>"
# EMAIL_DRY_RUN=1            render and record but never send, even with a key
# Protects /api/cron/notifications (reminders + retries). 16+ random characters, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
# Without it the endpoint answers 503 (off).
# CRON_SECRET=

# PostHog analytics (optional: tracking is disabled when the key is unset)
# Public project key (starts with phc_). EU projects use https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
